generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BankProvider {
  SICOOB
  BRADESCO
  INTER
  BTG
}

enum CredentialType {
  MTLS_CERT
  MTLS_KEYPAIR
  OAUTH2
}

enum StatementSource {
  API_SYNC
  OFX_IMPORT
  MANUAL
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  MANUAL
  IGNORED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

model Empresa {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String   @unique
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usuarios           Usuario[]
  tomadores          Tomador[]
  administradores    Administrador[]
  crmPipelines       CrmPipeline[]
  crmDeals           CrmDeal[]
  crmContatos        CrmContato[]
  crmMensagens       CrmMensagemWhatsapp[]
  iaProjetos         IaProjeto[]
  emitentes          EmpresaEmitente[]
  crmTags            CrmTag[]
}

model Usuario {
  id        String   @id @default(cuid())
  empresaId String?
  email     String   @unique
  senha     String
  nome      String
  role      String   @default("user") // "user" | "admin"
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  permissoes Json?   // { modulos?: string[], emitentes?: string[] } | null = full access
  whatsapp  String?  // somente dígitos ex: 5577999999999 — whitelist do Assistente Interno
  // Ramal SIP do APARELHO desta pessoa (app iOS). Fica separado do ramal do
  // emitente porque o AOR da recepção tem max_contacts=1 remove_existing=yes:
  // dois aparelhos no mesmo ramal derrubam um ao outro em silêncio.
  voipRamal       String?
  voipRamalSenha  String?

  empresa              Empresa?            @relation(fields: [empresaId], references: [id])
  projetoUsuarios      IaProjetoUsuario[]
  assistenteSessao     AssistenteSession?
  agendaSlots          AgendaSlot[]
}

model AssistenteSession {
  id         String   @id @default(cuid())
  phone      String   @unique
  usuarioId  String?  @unique
  step       String   @default("idle")
  contexto   Json?
  updatedAt  DateTime @updatedAt

  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}

model EmpresaEmitente {
  id                     String              @id @default(cuid())
  empresaId              String?
  nome                   String
  cnpj                   String              @unique
  inscricaoMunicipal     String
  regime                 String              @default("2")
  aliquotaIss            Float               @default(0.05)
  itemListaServico       String              @default("1.01")
  codTributacao          String              @default("0101")
  certNome               String?
  certValidade           DateTime?
  ativo                  Boolean             @default(true)
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt
  bairro                 String?
  cep                    String?
  cidade                 String?
  codigoMunicipio        String?
  complemento            String?
  email                  String?
  endereco               String?
  inscricaoEstadual      String?
  nomeFantasia           String?
  numero                 String?
  telefone               String?
  uf                     String?
  smtpFrom               String?
  smtpHost               String?
  smtpPass               String?
  smtpPort               Int?
  smtpSecure             Boolean             @default(false)
  smtpUser               String?
  certPass               String?
  logoPath               String?
  pixClientId            String?
  pixChave               String?
  boletoClientId         String?
  boletoNumeroCliente    String?
  boletoContaCorrente    String?
  boletoModalidade       String?             @default("1")
  boletoContratoCobranca String?
  boletoMultaPercent     Float?              @default(2)
  boletoJurosDiaPercent  Float?              @default(0.033)
  codigoNbs              String?
  codigoServicoNacional  String?
  regimeTributacao       String?
  timbradoPath           String?
  faturamentoAutoAtivo   Boolean             @default(false)
  diaEmissaoNfse         Int?
  voipDid                String?             // número principal com DDD (ex: +5561XXXXXXXX)
  voipDid2               String?             // DDD alternativo (ex: +5511XXXXXXXX)
  voipDid3               String?             // terceiro DID
  voipAsteriskWss        String?             // ex: wss://avoce.capium.com.br/asterisk-ws
  voipDid1Label          String?             // ex: "Brasília (61)"
  voipDid2Label          String?             // ex: "São Paulo (11)"
  voipDid3Label          String?             // ex: "BA (77)"
  voipSipExtension       String?             // ramal SIP ex: "6001"
  voipSipPassword        String?             // senha SIP
  voipSipDomain          String?             // domínio SIP ex: "asterisk.empresa.com"
  nfseProvider           String?             // "el_vdc" | "issnet_df" — provedor NFS-e
  codigoCnae             String?             // CNAE sem pontuação, ex: "6911701"
  nfseTpAmb              String?             // SPED: "1"=producao (default), "2"=homologacao
  nfseToken              String?             // E&L DPS: token de integração (cifrado) — portal → Configurações → Integração

  empresa            Empresa?          @relation(fields: [empresaId], references: [id])
  cobrancas          Cobranca[]
  contratos          Contrato[]
  notas              NotaFiscal[]
  propostas          Proposta[]
  templateDocumentos TemplateDocumento[]
  bankAccounts       BankAccount[]
  mktProjetos        MktProjeto[]
  ligacoes           CrmLigacao[]
  reunioes           SessaoReuniao[]
  agendaSlots        AgendaSlot[]
  lancamentos        Lancamento[]
  assinaturas        Assinatura[]
  // Financeiro gerencial + acordos
  finFontes          FinFonte[]
  finOrcamentos      FinOrcamento[]
  finEmprestimos     FinEmprestimo[]
  finAplicacoes      FinAplicacao[]
  finRecebimentos    FinRecebimento[]
  acordos            Acordo[]
}

model Lancamento {
  id         String   @id @default(cuid())
  tipo       String   // "receita" | "despesa"
  descricao  String
  categoria  String?
  valor      Decimal  @db.Decimal(14, 2)
  data       DateTime
  emitenteId String?
  dealId     String?
  pago       Boolean  @default(true)
  obs        String?
  criadoEm   DateTime @default(now())
  // Financeiro gerencial (plano AJUSTES-FINANCEIRO-ACORDOS)
  competencia         DateTime? // mês de competência (DRE/orçado×realizado); null = usa `data`
  fornecedor          String?
  formaPagamento      String?   // pix | boleto | cartao | transferencia | dinheiro | debito_automatico | outro
  comprovantePath     String?   // caminho no MinIO
  comprovanteNome     String?
  recorrente          Boolean   @default(false)
  recorrenciaFimEm    DateTime? // último mês gerado da série (null = sem fim)
  recorrenciaOrigemId String?   // id do lançamento que originou a série
  criadoPorId         String?

  emitente EmpresaEmitente? @relation(fields: [emitenteId], references: [id])
  fontes   FinLancamentoFonte[]

  @@index([data])
  @@index([emitenteId, tipo])
  @@index([emitenteId, competencia])
  @@index([recorrenciaOrigemId])
}

model Tomador {
  id                String          @id @default(cuid())
  empresaId         String?
  nome              String
  cpfCnpj           String
  email             String?
  emailFinanceiro   String?
  emailGeral        String?
  emailDiretoria    String?
  telefone          String?
  endereco          String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  codigoMunicipio   String?
  uf                String?
  cep               String?
  inscMunicipal     String?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt
  inscricaoEstadual String?
  nomeFantasia      String?
  dataNascimento    DateTime?
  nacionalidade     String?
  estadoCivil       String?
  profissao         String?
  rg                String?
  rgOrgaoEmissor    String?
  naturalidade      String?
  capitalSocial     Int?
  dataConstituicao  DateTime?
  tipoSocietario    String?
  objetoSocial      String?
  regimeCasamento   String?
  issRetido         Boolean         @default(false)

  empresa         Empresa?          @relation(fields: [empresaId], references: [id])
  administradores Administrador[]
  contratos       Contrato[]
  propostas       Proposta[]
  assinaturas     Assinatura[]

  @@unique([empresaId, cpfCnpj])
}

model Administrador {
  id              String    @id @default(cuid())
  empresaId       String?
  tomadorId       String
  nome            String
  cpf             String?
  cargo           String?   @default("Administrador")
  nacionalidade   String?
  estadoCivil     String?
  profissao       String?
  rg              String?
  rgOrgaoEmissor  String?
  dataNascimento  DateTime?
  naturalidade    String?
  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  uf              String?
  cep             String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  regimeCasamento String?

  empresa Empresa? @relation(fields: [empresaId], references: [id])
  tomador Tomador   @relation(fields: [tomadorId], references: [id])
}

model Contrato {
  id                   String          @id @default(cuid())
  emitenteId           String
  tomadorId            String
  descricaoServico     String
  valor                Int
  diaVencimento        Int
  issRetido            Boolean         @default(false)
  ativo                Boolean         @default(true)
  observacoes          String?
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @updatedAt
  codigoNbs            String?
  itemListaServico     String?
  retirCofins          Boolean         @default(false)
  retirCsll            Boolean         @default(false)
  retirIr              Boolean         @default(false)
  retirPis             Boolean         @default(false)
  nomeServico          String?
  gerarCobrancaAuto    Boolean         @default(true)
  metodoCobr           String          @default("PIX_BOLETO")
  emitirNfseAuto       Boolean         @default(true)
  tipoContrato         String          @default("RECORRENTE")
  totalParcelas        Int?
  contratoAssinadoPath String?
  contratoAssinadoNome String?
  contratoAssinadoEm   DateTime?
  nfseAoFaturar        Boolean         @default(true)
  emailsCobranca       String[]        @default([])

  cobrancas              Cobranca[]
  emitente               EmpresaEmitente              @relation(fields: [emitenteId], references: [id])
  tomador                Tomador                      @relation(fields: [tomadorId], references: [id])
  notas                  NotaFiscal[]
  proposta               Proposta?
  parcelasPersonalizadas ContratoParcelaPersonalizada[]
}

model ContratoParcelaPersonalizada {
  id             String   @id @default(cuid())
  contratoId     String
  numero         Int
  valor          Int
  dataVencimento String
  processada     Boolean  @default(false)
  criadoEm       DateTime @default(now())
  contrato       Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, numero])
}

model Proposta {
  id                        String            @id @default(cuid())
  emitenteId                String
  tomadorId                 String
  titulo                    String
  textoHtml                 String
  status                    String            @default("RASCUNHO")
  valorEstimado             Int?
  validadeAte               DateTime?
  tokenAceite               String            @unique @default(cuid())
  paktSignUrl               String?
  aceitoEm                  DateTime?
  aceitoIp                  String?
  contratoId                String?           @unique
  criadoEm                  DateTime          @default(now())
  atualizadoEm              DateTime          @updatedAt
  paktDocumentId            String?
  contratoDiaVencimento     Int?
  contratoMetodoCobr        String?           @default("PIX_BOLETO")
  contratoTipoContrato      String?           @default("RECORRENTE")
  contratoTotalParcelas     Int?
  contratoEmitirNfseAuto    Boolean?          @default(true)
  contratoGerarCobrancaAuto Boolean?          @default(true)
  contratoIssRetido         Boolean?          @default(false)
  contratoDescricao         String?
  paktSignedPdfPath         String?
  templatesGerar            String?
  honorariosExitoPerc       Float?
  followUpCount             Int       @default(0)
  followUpUltimoEm          DateTime?
  paktAssinadoEm            DateTime?

  // Revisão humana antes do envio para assinatura (fluxo de coleta de docs).
  // null = proposta manual, sem porteiro; PENDENTE = documentos gerados esperando
  // conferência; LIBERADA = alguém do escritório liberou e o envio já ocorreu.
  revisaoStatus             String?
  revisadoEm                DateTime?
  revisadoPor               String?
  // Origem quando a proposta nasce do agente: permite reenviar/liberar depois
  // usando a mesma instância de WhatsApp e o mesmo número que falou com o cliente.
  dealId                    String?
  iaProjetoId               String?
  envioTelefone             String?

  documentosGerados DocumentoGerado[]
  contrato          Contrato?         @relation(fields: [contratoId], references: [id])
  emitente          EmpresaEmitente   @relation(fields: [emitenteId], references: [id])
  tomador           Tomador           @relation(fields: [tomadorId], references: [id])
}

model TemplateDocumento {
  id           String            @id @default(cuid())
  emitenteId   String
  tipo         String
  titulo       String
  textoHtml    String
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  cabecalhoPath String?

  documentosGerados DocumentoGerado[]
  emitente          EmpresaEmitente   @relation(fields: [emitenteId], references: [id])
}

model DocumentoGerado {
  id          String            @id @default(cuid())
  propostaId  String
  templateId  String
  tipo        String
  titulo      String
  pdfPath     String?
  docxPath    String?
  htmlEditado String?
  criadoEm    DateTime          @default(now())
  // Preenchido quando o documento é salvo pelo editor OnlyOffice — é o sinal que
  // faz o preview do painel de revisão recarregar o PDF novo.
  atualizadoEm DateTime?

  proposta Proposta          @relation(fields: [propostaId], references: [id])
  template TemplateDocumento @relation(fields: [templateId], references: [id])
}

model Cobranca {
  id                   String          @id @default(cuid())
  contratoId           String
  emitenteId           String
  competencia          String
  valor                Int
  vencimento           String
  pixTxid              String?
  pixBrcode            String?
  pixQrcode            String?
  pixStatus            String          @default("PENDENTE")
  pixExpiresAt         DateTime?
  boletoNossoNumero    Int?
  boletoLinhaDigitavel String?
  boletoCodigoBarras   String?
  boletoUrlPdf         String?
  boletoStatus         String          @default("AGUARDANDO")
  boletoPagoEm         String?
  boletoValorPago      Int?
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @updatedAt
  pixEndToEndId        String?
  pixPagadorDoc        String?
  pixPagadorNome       String?
  pixPagoEm            DateTime?

  // ── Rastreamento de envio de e-mail (monitor de saúde) ──
  emailStatus        String    @default("PENDENTE")  // PENDENTE | ENVIADO | FALHA
  emailEnviadoEm     DateTime?
  emailErro          String?
  emailTentativas    Int       @default(0)
  emailUltTentativa  DateTime?
  emailDestinatarios String[]  @default([])

  // Baixa manual (depósito / PIX avulso / etc.)
  baixaManualStatus         String?   // "PAGO" | "ESTORNADO"
  baixaManualEm             DateTime?
  baixaManualPorId          String?
  baixaManualPorNome        String?
  baixaManualPorEmail       String?
  baixaManualFormaPagamento String?   // "PIX" | "DEPOSITO" | "TRANSFERENCIA" | "OUTRO"
  baixaManualValorPago      Int?      // centavos
  baixaManualDataRecebimento String?  // YYYY-MM-DD
  baixaManualPagadorNome    String?
  baixaManualPagadorDoc     String?
  baixaManualBanco          String?
  baixaManualObs            String?

  contrato       Contrato         @relation(fields: [contratoId], references: [id])
  emitente       EmpresaEmitente  @relation(fields: [emitenteId], references: [id])
  bankStatement  BankStatement?
  statementMatch BankStatementMatch?
  baixaLogs      CobrancaBaixaLog[]

  reconciledAt    DateTime?
  reconciledBy    String?
}

model CobrancaBaixaLog {
  id               String   @id @default(cuid())
  cobrancaId       String
  acao             String   // "BAIXA_MANUAL" | "ESTORNO_BAIXA_MANUAL"
  usuarioId        String
  usuarioNome      String
  usuarioEmail     String
  formaPagamento   String?
  valorPago        Int?
  dataRecebimento  String?
  pagadorNome      String?
  pagadorDoc       String?
  banco            String?
  obs              String?
  criadoEm         DateTime @default(now())

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id])
}

model NotaFiscal {
  id           String          @id @default(cuid())
  contratoId   String
  emitenteId   String
  competencia  String
  valor        Int
  numero       String?
  codigoVerif  String?
  status       String          @default("PENDENTE")
  xmlRetorno   String?
  linkNfse     String?
  nDps         Int?            // E&L DPS: nº da DPS (série 900); reenviar o mesmo nº reprocessa sem duplicar
  idDps        String?         @unique
  chaveAcesso  String?         // chave nacional (50 dígitos) da NFS-e emitida por DPS
  emailEnviadoEm DateTime?     // NFS-e (PDF/XML) entregue ao tomador — avulsa ou junto da cobrança
  erroMsg      String?
  emitidoEm    DateTime?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  contrato Contrato        @relation(fields: [contratoId], references: [id])
  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])
}

// ─────────────────────────────────────────────
// CRM — Funil Kanban (Avoce)
// ─────────────────────────────────────────────

model CrmPipeline {
  id          String     @id @default(cuid())
  empresaId   String?
  nome        String
  descricao   String?
  cor         String     @default("#6366f1")
  ordem       Int        @default(0)
  tipo        String     @default("comercial") // comercial | processual
  ativo       Boolean    @default(true)
  criadoEm    DateTime   @default(now())
  pipedriveId Int?       @unique

  empresa  Empresa?    @relation(fields: [empresaId], references: [id])
  stages   CrmStage[]
  deals    CrmDeal[]
  projetos IaProjeto[]
  tags     CrmTag[]
}

model CrmStage {
  id               String   @id @default(cuid())
  pipelineId       String
  chave            String
  nome             String
  ordem            Int
  cor              String   @default("#6366f1")
  ehEntrada        Boolean  @default(false)
  ehGanho          Boolean  @default(false)
  ehEncerramento   Boolean  @default(false)
  requerAcaoHumana Boolean  @default(false)
  ativo            Boolean  @default(true)
  pipedriveId      Int?     @unique

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([pipelineId, chave])
}

model CrmDeal {
  id               String    @id @default(cuid())
  empresaId        String?
  titulo           String
  pipelineId       String
  stageId          String
  contatoId        String?
  responsavelId    String?
  projetoId        String?
  valor            Decimal?  @db.Decimal(12, 2)
  status           String    @default("aberto") // aberto | ganho | perdido
  urgencia         Boolean   @default(false)
  fonteLead        String?
  // Origem rastreada da 1ª mensagem (Meta Click-to-WhatsApp / link wa.me / orgânico).
  // Vem do contextInfo do webhook da Evolution (externalAdReply + entryPointConversionSource).
  origemPlataforma    String?   // facebook | instagram | site | whatsapp | telefone
  origemTipo          String?   // anuncio | link | organico
  origemAnuncioId     String?   // Meta ad id (externalAdReply.sourceId)
  origemAnuncioTitulo String?
  origemAnuncioTexto  String?
  origemUrl           String?
  origemEm            DateTime?
  // Click-to-WhatsApp: id do clique (externalAdReply.ctwaClid) — é o que a Conversions API
  // for Business Messaging usa para atribuir o evento ao anúncio. Ver lib/meta-capi.ts.
  origemCtwaClid      String?
  origemSourceType    String?   // externalAdReply.sourceType (ad | post)
  origemEntryPoint    String?   // entryPointConversionSource (ctwa_ad | click_to_chat_link | ...)
  descricao        String?
  camposCustom     Json?
  numeroCnj        String?
  proximoPrazo     DateTime?
  qualificacao     Json?
  ultimoContatoEm  DateTime?
  // Último follow-up HUMANO (ligação registrada, mensagem do painel ou do celular, chamada
  // de WhatsApp). Diferente de ultimoContatoEm, que mexe a cada mensagem da IA ou do lead.
  // Ordena o Kanban: sem follow-up no topo por chegada; com follow-up vai para o fim.
  followupEm       DateTime?
  // Avaliação jurídica
  parecer          String?   // Texto do parecer da Dra. Daniela
  valorEstimado    Decimal?  @db.Decimal(12, 2)  // Estimativa IA do valor da causa
  valorCausaAjuizada Decimal? @db.Decimal(12, 2) // Valor da causa no processo ajuizado
  valorCondenacao  Decimal?  @db.Decimal(12, 2)  // Valor da condenação
  valorAcordo      Decimal?  @db.Decimal(12, 2)  // Valor do acordo homologado
  ajuizadoEm       DateTime? // data do protocolo da inicial (base do "tempo até o acordo/recebimento")
  // Audiência designada — alimenta as mensagens automáticas ao cliente
  audienciaEm          DateTime? // data e hora da audiência
  audienciaTipo        String?   // inicial_protocolo | inicial_posterior | instrucao | una
  audienciaModalidade  String?   // presencial | virtual
  audienciaLocal       String?   // endereço da vara ou link da sala virtual
  audienciaAvisadaEm   DateTime? // quando a mensagem de designação foi enviada ao cliente
  audienciaLembreteEm  DateTime? // último lembrete enviado (trava 1 por dia)
  // IA fields
  iaAtiva              Boolean   @default(true)
  iaStageChave         String?
  iaPersonaChave       String?
  iaPersonaTrocadaEm   DateTime?
  iaPausadaPor         String?
  iaPausadaEm      DateTime?
  closerTentativas Int       @default(0)
  proximoContatoEm DateTime?
  proximoContatoPor String?  // usuário que marcou o próximo follow-up (dono da ligação no painel diário)
  docsConfirmados  Boolean   @default(false)
  iaFlowStepChave          String?   // current step in flow controller (advogado phase)
  iaFlowStepData           Json?     // data collected by flow controller (advogado phase)
  iaFlags                  Json?     // internal AI operational flags (keys prefixed with _)
  // Pipedrive sync fields
  pipedriveId              Int?      @unique
  organizacao              String?
  motivoPerda              String?
  dataFechamentoEsperada   DateTime?
  rotulo                   String?
  probabilidade            Float?
  moeda                    String?
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt

  empresa  Empresa?             @relation(fields: [empresaId], references: [id])
  pipeline  CrmPipeline         @relation(fields: [pipelineId], references: [id])
  stage     CrmStage            @relation(fields: [stageId], references: [id])
  contato   CrmContato?         @relation(fields: [contatoId], references: [id])
  projeto   IaProjeto?          @relation(fields: [projetoId], references: [id])
  stageLog  CrmDealStageLog[]
  notas     CrmNota[]
  mensagens CrmMensagemWhatsapp[]
  vinculos  CrmVinculoEmprego[]
  ligacoes  CrmLigacao[]
  reunioes  SessaoReuniao[]
  anexos    DealAnexo[]
  tags      CrmTag[]            @relation("DealTags")
  eventosMeta MetaConversaoEvento[]
  atividades  CrmAtividade[]
  // Funil de acordos + recebimentos (plano AJUSTES-FINANCEIRO-ACORDOS)
  acordos         Acordo[]
  acordoAvaliacao AcordoAvaliacao?
  recebimentos    FinRecebimento[]
}

// Fila persistente (outbox) de eventos de conversão devolvidos à Meta.
// Uma linha por (deal, evento): o eventId é determinístico, então emitir de novo
// é no-op. Quem grava é agent/lead-qualificado.ts; quem envia é lib/meta-capi.ts.
model MetaConversaoEvento {
  id                String    @id @default(cuid())
  eventId           String    @unique            // sha256(dealId:eventName)
  dealId            String
  projetoId         String?
  eventName         String                       // QualifiedLead
  ctwaClid          String?
  via               String?                      // caminho que marcou (ia:qualificacao_completa, crm:manual, ...)
  stageChave        String?
  ocorridoEm        DateTime
  // pendente | enviado | falhou (vai tentar de novo) | morto (esgotou tentativas) | sem_ctwa | expirado
  status            String    @default("pendente")
  tentativas        Int       @default(0)
  proximaTentativaEm DateTime @default(now())
  enviadoEm         DateTime?
  testEventCode     String?
  payload           Json?
  resposta          Json?
  erro              String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([status, proximaTentativaEm])
  @@index([projetoId, criadoEm])
}

model DealAnexo {
  id              String   @id @default(cuid())
  dealId          String
  deal            CrmDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  nomeArquivo     String
  mimetype        String
  tamanho         Int?
  caminhoArquivo  String
  ocrTexto        String?
  tipoDocumento   String?
  dadosExtraidos  Json?
  criadoEm        DateTime @default(now())

  @@index([dealId])
}

model CrmTag {
  id         String    @id @default(cuid())
  empresaId  String?
  // Funil ao qual a tag pertence. null = tag geral, vale para todos os funis.
  // O WhatsApp IA e o Kanban mostram só as tags do funil em foco + as gerais.
  pipelineId String?
  nome       String
  cor        String    @default("#6366f1")
  criadoEm   DateTime  @default(now())

  empresa    Empresa?     @relation(fields: [empresaId], references: [id])
  pipeline   CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  deals      CrmDeal[]    @relation("DealTags")

  @@index([pipelineId])
}

model CrmDealStageLog {
  id              String   @id @default(cuid())
  dealId          String
  stageAnteriorId String?
  stageNovoId     String
  usuarioId       String?
  motivo          String?
  criadoEm        DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model CrmNota {
  id        String   @id @default(cuid())
  dealId    String
  usuarioId String?
  conteudo  String
  criadoEm  DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model CrmContato {
  id           String   @id @default(cuid())
  empresaId    String?
  nome         String
  whatsapp     String?
  cpf          String?
  email        String?
  cidade       String?
  profissao    String?
  // Pipedrive sync fields
  pipedriveId  Int?     @unique
  telefone     String?
  empresa      String?
  // Foto de perfil do WhatsApp (Evolution /chat/fetchProfilePictureUrl). A URL do
  // pps.whatsapp.net expira em ~10 dias, por isso o arquivo é baixado para disco
  // (uploads/fotos-perfil/<id>.jpg) e servido por /api/contato-foto/:id.
  // fotoPerfilEm marca a última tentativa (mesmo sem foto) para não consultar de novo.
  fotoPerfilUrl String?
  fotoPerfilEm  DateTime?
  // Instagram Direct / Messenger (lib/meta-social.ts): ids de conversa da Meta (IGSID / PSID).
  instagramId       String?
  instagramUsername String?
  messengerId       String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresaRel Empresa?           @relation(fields: [empresaId], references: [id])
  deals      CrmDeal[]
  mensagens  CrmMensagemWhatsapp[]
  ligacoes   CrmLigacao[]
  reunioes   SessaoReuniao[]

  @@index([instagramId])
  @@index([messengerId])
}

