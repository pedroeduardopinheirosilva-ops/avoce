model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Marketing Autopilot — Automação de Marketing
// ─────────────────────────────────────────────

enum MktPlataforma {
  META
  GOOGLE
}

enum MktCampanhaStatus {
  ATIVA
  PAUSADA
  ARQUIVADA
  RASCUNHO
}

enum MktCriativoStatus {
  ATIVO
  PAUSADO
  ARQUIVADO
}

enum MktAutonomia {
  TOTAL
  NOTIFICAR
  SUGERIR
}

enum MktFormato {
  REEL
  CARROSSEL
  POST
  STORY
}

enum MktRoteiroStatus {
  GERADO
  GRAVADO
  EDITADO
  APROVADO
}

enum MktPublicacaoStatus {
  RASCUNHO
  AGUARDANDO_MIDIA
  PROCESSANDO_CONTAINER
  AGENDADO
  PUBLICADO
  FALHOU
}

model MktProjeto {
  id           String   @id @default(cuid())
  emitenteId   String
  nome         String
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  emitente    EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  configs     MktConfig[]
  campanhas   MktCampanha[]
  roteiros    MktRoteiro[]
  publicacoes MktPublicacao[]
  logs        MktLogAcao[]
}

// Credenciais e settings — segue padrão exato de IaProjetoConfig
model MktConfig {
  id             String   @id @default(cuid())
  projetoId      String
  chave          String
  valor          String?
  valorEncrypted Boolean  @default(false)
  tipo           String   @default("texto") // texto | senha | booleano | numero
  categoria      String   @default("geral") // meta | google | deepseek | imagem | video
  descricao      String?
  editavelPainel Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  projeto MktProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

// Campanhas sincronizadas do Meta Ads e Google Ads
model MktCampanha {
  id              String            @id @default(cuid())
  projetoId       String
  plataforma      MktPlataforma
  idExterno       String
  nome            String
  status          MktCampanhaStatus @default(ATIVA)
  orcamentoDiario Float?
  cpaMeta         Float?
  roasMeta        Float?
  autonomia       MktAutonomia      @default(NOTIFICAR)
  // Métricas atuais (atualizadas a cada hora)
  impressoes      Int               @default(0)
  cliques         Int               @default(0)
  gastoTotal      Float             @default(0)
  cpaAtual        Float?
  roasAtual       Float?
  ctrAtual        Float?
  // Controle de violação de KPI consecutiva
  kpiVioladoCount Int               @default(0)
  ultimaSincEm    DateTime?
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  projeto   MktProjeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  criativos MktCriativo[]

  @@unique([projetoId, idExterno, plataforma])
}

model MktCriativo {
  id           String            @id @default(cuid())
  campanhaId   String
  idExterno    String
  nome         String
  status       MktCriativoStatus @default(ATIVO)
  ctr          Float?
  cpc          Float?
  pausadoPorIa Boolean           @default(false)
  motivoPausa  String?
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  campanha MktCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, idExterno])
}

// Roteiros de vídeo gerados pelo DeepSeek
model MktRoteiro {
  id            String           @id @default(cuid())
  projetoId     String
  advogadoNome  String
  areaDireito   String
  tema          String
  formato       MktFormato
  tom           String
  titulo        String
  cenas         Json             // [{ordem, descricao, duracao, textoNarrado, dicaGravacao}]
  caption       String           @db.Text
  hashtags      String[]
  dicasGravacao String[]
  promptUsado   String           @db.Text
  status        MktRoteiroStatus @default(GERADO)
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  projeto     MktProjeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  publicacoes MktPublicacao[]
}

// Calendário editorial — posts agendados para o Instagram
model MktPublicacao {
  id           String              @id @default(cuid())
  projetoId    String
  roteiroId    String?
  titulo       String
  legenda      String              @db.Text
  hashtags     String[]
  urlMidia     String?
  containerId  String?             // Meta container ID — polling enquanto PROCESSANDO_CONTAINER
  agendadoPara DateTime?
  publicadoEm  DateTime?
  idPostIg     String?
  status       MktPublicacaoStatus @default(RASCUNHO)
  // Métricas coletadas após publicação
  alcance      Int?
  impressoes   Int?
  likes        Int?
  comentarios  Int?
  plays        Int?
  aprovadoEm   DateTime?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  projeto  MktProjeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  roteiro  MktRoteiro? @relation(fields: [roteiroId], references: [id])
}

model CrmCampanhaReengajamento {
  id             String    @id @default(cuid())
  empresaId      String?
  projetoId      String?
  pipelineId     String?
  nome           String
  stageIds       String[]
  diasSemContato Int       @default(7)
  mensagem       String    @db.Text
  ativa          Boolean   @default(true)
  ultimoDisparo  DateTime?
  totalEnviados  Int       @default(0)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  // Campanha IA personalizada
  tipo              String    @default("fixo")   // "fixo" | "ia_personalizada"
  promptInicial     String?   @db.Text           // prompt LLM para msg inicial personalizada
  promptHistorico   String?   @db.Text           // prompt LLM para resumo histórico pós-resposta
  sourcePipelineIds String[]  @default([])       // pipelines de origem dos leads
  destPipelineId    String?                      // pipeline destino após engajamento
  destStageMap      Json?                        // {stageChave: destStageChave, default: "..."}

  projeto IaProjeto? @relation(fields: [projetoId], references: [id])
}

// Log de toda ação automática — auditoria e reversão
model MktLogAcao {
  id           String   @id @default(cuid())
  projetoId    String
  tipo         String   // campanha_pausada | orcamento_ajustado | post_publicado | criativo_pausado | token_alerta
  entidadeId   String
  entidadeTipo String   // MktCampanha | MktCriativo | MktPublicacao
  valorAntes   Json?
  valorDepois  Json?
  motivoIa     String?  // reasoning do DeepSeek
  revertivel   Boolean  @default(false)
  revertido    Boolean  @default(false)
  revertidoEm  DateTime?
  ok           Boolean  @default(true)
  erroDetalhe  String?
  criadoEm     DateTime @default(now())

  projeto MktProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// VoIP — Ligações
// ─────────────────────────────────────────────

enum CrmLigacaoStatus {
  DISCANDO
  EM_ANDAMENTO
  ENCERRADA
  FALHOU
  SEM_RESPOSTA
  OCUPADO
}

model CrmLigacao {
  id               String           @id @default(cuid())
  dealId           String
  contatoId        String
  emitenteId       String
  usuarioId        String?

  numeroOrigem     String
  numeroDestino    String
  did              String?           // "61" | "11"
  duracao          Int?              // segundos
  status           CrmLigacaoStatus  @default(DISCANDO)

  asteriskUniqueId String?
  gravacaoMinio    String?           // chave no bucket avoce-calls
  transcricao      String?           @db.Text
  resumo           String?           @db.Text

  iniciadaEm       DateTime          @default(now())
  encerradaEm      DateTime?

  deal     CrmDeal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contato  CrmContato      @relation(fields: [contatoId], references: [id])
  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])

  @@index([dealId])
}

// ─────────────────────────────────────────────
// Reuniões — Videochamadas via Jitsi
// ─────────────────────────────────────────────

model SessaoReuniao {
  id              String    @id @default(cuid())
  dealId          String?
  contatoId       String?
  empresaId       String?
  emitenteId      String?
  criadoPor       String?
  titulo          String
  status          String    @default("agendada") // agendada | em_andamento | encerrada | cancelada
  jitsiRoomName   String    @unique
  tokenConvidado  String    @unique @default(cuid())
  agendadaPara    DateTime?
  iniciadaEm      DateTime?
  encerradaEm     DateTime?
  duracao         Int?
  transcricao     String?   @db.Text
  notas           String?   @db.Text
  resumoIa        String?   @db.Text  // relatório IA pós-reunião
  consentimentoEm DateTime? // consentimento LGPD do convidado p/ gravação+transcrição
  consentimentoIp String?
  // Agendamento pelo SDR/closer: `criadoPor` = quem marcou; `responsavelId` = quem conduz.
  // `notas` (acima) são as anotações. avisarCliente=false → sem confirmação nem lembretes.
  pauta           String?   @db.Text
  responsavelId   String?
  duracaoMin      Int       @default(60)
  modalidade      String    @default("video") // video | whatsapp | telefone | presencial
  avisarCliente   Boolean   @default(true)
  criadaEm        DateTime  @default(now())
  atualizadaEm    DateTime  @updatedAt

  deal     CrmDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contato  CrmContato?      @relation(fields: [contatoId], references: [id])
  emitente EmpresaEmitente? @relation(fields: [emitenteId], references: [id])
  chunks   ReuniaoTranscricaoChunk[]

  @@index([agendadaPara])
  @@index([responsavelId, agendadaPara])
}

// Transcrição de reunião — 1 chunk por fala, rotulado por quem gravou
// (cada participante transcreve o próprio microfone; papel conhecido a priori)
model ReuniaoTranscricaoChunk {
  id             String   @id @default(cuid())
  sessaoId       String
  speakerRole    String   @default("indefinido") // operador | convidado | indefinido
  speakerNome    String?
  conteudo       String   @db.Text
  inicioSegundos Int?     // contador local da página de quem gravou (aproximado)
  origem         String   @default("whisper")    // webspeech | whisper
  criadaEm       DateTime @default(now())

  sessao SessaoReuniao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId, criadaEm])
}

// Agenda — Slots de disponibilidade para reuniões
// ─────────────────────────────────────────────

model AgendaSlot {
  id            String    @id @default(cuid())
  emitenteId    String
  usuarioId     String?
  projetoId     String?
  titulo        String?
  inicio        DateTime
  fim           DateTime
  disponivel    Boolean   @default(true)
  reservadoPara String?   // dealId quando reservado
  reuniaoId     String?   // SessaoReuniao.id quando criada
  criadaEm      DateTime  @default(now())

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id], onDelete: Cascade)
  usuario  Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emitenteId, inicio])
  @@index([projetoId, inicio])
  @@index([usuarioId, inicio])
}

// ─────────────────────────────────────────────
// SDR Gates — Desqualificação configurável
// ─────────────────────────────────────────────

model IaGateSdr {
  id             String   @id @default(cuid())
  projetoId      String
  nome           String
  tipo           String   // prescricao | empresa_bloqueada | vinculo_invalido | nao_carreteiro | tempo_minimo | campo_booleano
  campoGatilho   String?
  condicaoJson   Json?
  mensagemLead   String   @db.Text
  motivoChave    String   @default("gate_desqualificado")
  stageDestino   String   @default("lead_desqualificado")
  ativo          Boolean  @default(true)
  ordem          Int      @default(0)
  criadoEm       DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId, ativo])
}

model IaEmpresaBloqueada {
  id         String   @id @default(cuid())
  projetoId  String
  nome       String
  nomeNorm   String
  motivo     String   @default("prescricao_coletiva")
  descricao  String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId, ativo])
}

// ─────────────────────────────────────────────
// Assinaturas — assinatura eletrônica via PAKT
// ─────────────────────────────────────────────

model Assinatura {
  id                        String    @id @default(cuid())
  paktDocumentId            String?   @unique
  emitenteId                String    // escritório remetente (RAP ou PSA) citado no texto
  nome                      String
  status                    String    @default("DRAFT")
  mensagem                  String?   @db.Text
  expiresAt                 DateTime?
  paktResponse              Json?

  arquivoNome               String?
  arquivoPath               String?
  arquivoTamanho            Int?
  arquivoAssinadoPath       String?
  arquivoAssinadoEm         DateTime?

  criadoPorId               String?
  criadoPorNome             String?

  signatarios               Json      @default("[]")

  tomadorId                 String?
  dealId                    String?

  emailEnviado              Boolean   @default(false)
  emailEnviadoEm            DateTime?
  whatsappEnviado           Boolean   @default(false)
  whatsappEnviadoEm         DateTime?
  whatsappAssinadoEnviado   Boolean   @default(false)
  whatsappAssinadoEnviadoEm DateTime?

  webhookEventos            Json      @default("[]")

  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  tomador  Tomador?        @relation(fields: [tomadorId], references: [id])

  @@index([emitenteId, status])
  @@index([criadoEm])
}

// Entregável enviado ao lead quando ele termina a triagem: vídeo (ou imagem/PDF) curto da
// advogada sobre a dor principal dele — horas extras, tempo de espera, diárias, carga perigosa.
// Recomendação da mentoria comercial de 12/09/2026: aquece o lead e quebra a desconfiança antes
// da ligação. A escolha é por palavra-chave (sem LLM); `padrao` cobre quem não casou com nenhum.
model IaEntregavel {
  id            String   @id @default(cuid())
  projetoId     String
  chave         String
  titulo        String
  palavrasChave String   @default("")  // termos separados por "|", casados na qualificação e nas mensagens do lead
  legenda       String?
  arquivoPath   String?
  arquivoTipo   String?                // video | image | document
  arquivoNome   String?
  padrao        Boolean  @default(false)
  ativo         Boolean  @default(true)
  ordem         Int      @default(0)
  criadoEm      DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

// Atividade comercial registrada à mão pelo SDR/closer: a ligação feita pelo celular e a
// reunião que aconteceu (ou não). Sem isso o painel não tinha como contar "ligações
// atendidas", "reuniões realizadas" e "no-show" — a SDR fazia o relatório diário na mão.
model CrmAtividade {
  id         String    @id @default(cuid())
  dealId     String
  tipo       String    // ligacao | reuniao | encerramento
  // ligacao: atendeu | nao_atendeu | recusou | pediu_retorno | numero_errado
  // reuniao: agendada | realizada | no_show | remarcada | cancelada · encerramento: ganho | perdido | aberto
  resultado  String
  nota       String?
  usuarioId  String?
  // Ligação: por onde (whatsapp | celular | voip), sentido (saida | entrada) e quanto durou.
  // Reunião: video | whatsapp | telefone | presencial, e quanto durou.
  canal      String?
  direcao    String?
  duracaoSeg Int?
  // manual = SDR registrou; automatica = veio do evento CALL do Evolution (chamada de WhatsApp
  // feita/recebida no número da instância) ou da sala de reunião do Avoce (externoId "reuniao:<sessão>").
  // externoId evita registrar em dobro.
  origem     String    @default("manual")
  externoId  String?   @unique
  atendidaEm DateTime?
  criadoEm   DateTime  @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, criadoEm])
  @@index([tipo, criadoEm])
}

// ─────────────────────────────────────────────
// Disparo segmentado (lib/disparos.ts) — mensagem para um recorte do funil
// (etapa, etiqueta, origem), enviada devagar pelo cron para não queimar o número.
// ─────────────────────────────────────────────

model CrmDisparo {
  id           String   @id @default(cuid())
  empresaId    String?
  projetoId    String
  nome         String
  mensagem     String
  filtro       Json
  status       String   @default("rascunho") // rascunho | enviando | pausado | concluido | cancelado
  intervaloSeg Int      @default(90)
  limiteDia    Int      @default(60)
  total        Int      @default(0)
  enviados     Int      @default(0)
  falhas       Int      @default(0)
  pulados      Int      @default(0)
  criadoPor    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itens CrmDisparoItem[]

  @@index([status])
}

model CrmDisparoItem {
  id        String    @id @default(cuid())
  disparoId String
  dealId    String
  canal     String    // whatsapp | instagram | messenger
  status    String    @default("pendente") // pendente | enviado | falha | pulado
  erro      String?
  enviadoEm DateTime?

  disparo CrmDisparo @relation(fields: [disparoId], references: [id], onDelete: Cascade)

  @@unique([disparoId, dealId])
  @@index([disparoId, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// Financeiro gerencial (plano PLANO-AJUSTES-FINANCEIRO-ACORDOS.md)
// Valores Decimal(14,2); taxas em % a.m. Decimal(12,8). Cálculo em lib/fin/.
// ═══════════════════════════════════════════════════════════════════════════

// Fonte de recursos que paga despesas (rateio) e recebe resgates de aplicação.
model FinFonte {
  id           String   @id @default(cuid())
  emitenteId   String
  nome         String
  tipo         String   // emprestimo_psa | emprestimo_bancario | receita_propria | outra
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  emitente        EmpresaEmitente      @relation(fields: [emitenteId], references: [id])
  lancamentos     FinLancamentoFonte[]
  emprestimos     FinEmprestimo[]
  aplicacaoMovs   FinAplicacaoMov[]

  @@index([emitenteId, ativo])
}

// Rateio de um lançamento entre fontes — soma dos valores = valor do lançamento.
model FinLancamentoFonte {
  id           String   @id @default(cuid())
  lancamentoId String
  fonteId      String
  valor        Decimal  @db.Decimal(14, 2)
  percentual   Decimal? @db.Decimal(7, 4) // informativo (ex.: 33.3333); o valor manda
  criadoEm     DateTime @default(now())

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  fonte      FinFonte   @relation(fields: [fonteId], references: [id])

  @@index([lancamentoId])
  @@index([fonteId])
}

// Orçamento mensal por categoria de despesa.
model FinOrcamento {
  id           String   @id @default(cuid())
  emitenteId   String
  categoria    String
  ano          Int
  mes          Int      // 1..12
  valor        Decimal  @db.Decimal(14, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])

  @@unique([emitenteId, categoria, ano, mes])
  @@index([emitenteId, ano, mes])
}

// Índice mensal GLOBAL (não é por emitente). BCB/SGS: série 4390 (Selic) e 4391 (CDI).
model FinIndiceMensal {
  id           String   @id @default(cuid())
  indice       String   // selic | cdi
  ano          Int
  mes          Int      // 1..12
  taxa         Decimal  @db.Decimal(12, 8) // % a.m. (ex.: 1.10000000 = 1,10% no mês)
  origem       String   @default("bcb") // bcb | manual (manual não é sobrescrita pelo cron)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([indice, ano, mes])
}

// Empréstimo: da PSA (corrigido pela Selic por aporte, FIFO) ou bancário (Selic + spread, SAC/Price).
model FinEmprestimo {
  id              String   @id @default(cuid())
  emitenteId      String
  fonteId         String?
  tipo            String   // psa | bancario
  nome            String
  dataContratacao DateTime
  valor           Decimal? @db.Decimal(14, 2) // principal contratado (bancário); PSA usa os aportes
  carenciaMeses   Int      @default(0)
  spreadAnual     Decimal  @default(6) @db.Decimal(7, 4) // % a.a. sobre a Selic (bancário)
  numParcelas     Int?     // parcelas de amortização após a carência
  sistema         String?  // sac | price
  carenciaModo    String?  // juros_pagos | capitalizados
  iof             Decimal? @db.Decimal(14, 2)
  tarifas         Decimal? @db.Decimal(14, 2)
  ativo           Boolean  @default(true)
  obs             String?
  criadoPorId     String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  emitente EmpresaEmitente    @relation(fields: [emitenteId], references: [id])
  fonte    FinFonte?          @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  movs     FinEmprestimoMov[]

  @@index([emitenteId, tipo])
}

model FinEmprestimoMov {
  id           String   @id @default(cuid())
  emprestimoId String
  // saldo_inicial | aporte | amortizacao | devolucao | pagamento_juros | pagamento_parcela
  tipo         String
  data         DateTime
  valor        Decimal  @db.Decimal(14, 2) // sempre positivo; o tipo dá o sinal
  previsto     Boolean  @default(false)    // aporte futuro da PSA (só entra na projeção)
  obs          String?
  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  emprestimo FinEmprestimo @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)

  @@index([emprestimoId, data])
}

// Aplicação financeira (CDB/fundo) remunerada pela Selic ou % do CDI.
model FinAplicacao {
  id                  String   @id @default(cuid())
  emitenteId          String
  nome                String
  produto             String?  // CDB, LCI, fundo DI…
  indexador           String   @default("cdi") // selic | cdi
  percentualIndexador Decimal  @default(100) @db.Decimal(7, 2) // % do indexador (ex.: 102 = 102% do CDI)
  ativo               Boolean  @default(true)
  obs                 String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  emitente EmpresaEmitente   @relation(fields: [emitenteId], references: [id])
  movs     FinAplicacaoMov[]

  @@index([emitenteId, ativo])
}

model FinAplicacaoMov {
  id          String   @id @default(cuid())
  aplicacaoId String
  tipo        String   // aplicacao | resgate | rendimento | ir
  data        DateTime
  valor       Decimal  @db.Decimal(14, 2) // sempre positivo; o tipo dá o sinal
  fonteId     String?  // obrigatório no resgate (fonte que recebe o dinheiro)
  obs         String?
  criadoPorId String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aplicacao FinAplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)
  fonte     FinFonte?    @relation(fields: [fonteId], references: [id], onDelete: SetNull)

  @@index([aplicacaoId, data])
  @@index([fonteId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Funil de acordos — registro paralelo ao CrmDeal (não mexe em stage/prazos)
// ═══════════════════════════════════════════════════════════════════════════

// Uma tentativa de acordo. Um deal pode ter vários (histórico), no máximo um em aberto.
model Acordo {
  id                    String    @id @default(cuid())
  dealId                String
  emitenteId            String?
  tipo                  String    // previo | posterior
  // em_negociacao | firmado | aguardando_homologacao | homologado | sem_acordo
  status                String    @default("em_negociacao")
  motivo                String?   // por que tentar o acordo (texto livre)
  // previo | pos_contestacao | pos_replica | pos_pericia | pos_sentenca | recursal | execucao
  faseOrigem            String?
  responsavelId         String?
  contatoEmpresaNome    String?
  contatoEmpresaPapel   String?   // preposto | advogado
  contatoEmpresaFone    String?
  estimativaCondenacao  Decimal?  @db.Decimal(14, 2)
  valorMinimoAutorizado Decimal?  @db.Decimal(14, 2) // piso autorizado pelo cliente
  autorizacaoRegistro   String?   // como/quando o cliente autorizou
  autorizacaoAnexoPath  String?
  autorizacaoAnexoNome  String?
  proximoFollowupEm     DateTime?
  motivoSaida           String?   // empresa_recusou | abaixo_minimo | cliente_recusou | sem_resposta
  obsSaida              String?
  valorAcordo           Decimal?  @db.Decimal(14, 2)
  percHonorarios        Decimal?  @db.Decimal(5, 2) // % contratual sobre cada parcela
  multaInadimplemento   Decimal?  @db.Decimal(14, 2) // % ou R$, conforme multaTipo
  multaTipo             String?   // percentual | valor
  enviadoExecucaoEm     DateTime?
  firmadoEm             DateTime?
  homologadoEm          DateTime?
  encerradoEm           DateTime?
  criadoPorId           String?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  deal         CrmDeal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  emitente     EmpresaEmitente?  @relation(fields: [emitenteId], references: [id])
  rodadas      AcordoRodada[]
  recebimentos FinRecebimento[]
  avaliacoes   AcordoAvaliacao[]

  @@index([dealId])
  @@index([emitenteId, status])
  @@index([status, proximoFollowupEm])
}

// Proposta/contraproposta de uma negociação.
model AcordoRodada {
  id          String   @id @default(cuid())
  acordoId    String
  data        DateTime
  autor       String   // escritorio | empresa
  valor       Decimal? @db.Decimal(14, 2)
  obs         String?
  criadoPorId String?
  criadoEm    DateTime @default(now())

  acordo Acordo @relation(fields: [acordoId], references: [id], onDelete: Cascade)

  @@index([acordoId, data])
}

// Tarefa de avaliação prévia de acordo (§2.1), criada quando o deal é ajuizado. 1 por deal.
model AcordoAvaliacao {
  id            String    @id @default(cuid())
  dealId        String    @unique
  responsavelId String?
  prazoEm       DateTime?
  decisao       String?   // tentar | nao_tentar (null = pendente)
  justificativa String?
  decididoEm    DateTime?
  decididoPorId String?
  acordoId      String?   // acordo aberto a partir da decisão "tentar"
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  acordo Acordo? @relation(fields: [acordoId], references: [id], onDelete: SetNull)

  @@index([decisao, prazoEm])
  @@index([responsavelId])
}

// Recebimento: parcela de acordo (acordoId + parcelaNumero) ou valor avulso de execução/sentença.
// Receita do escritório = valorHonorarios + valorSucumbencia; valorRepasse é de terceiro (cliente).
// Status derivado (não gravado): recebida (tem dataRecebimento) | em_atraso (vencida) | prevista.
model FinRecebimento {
  id                      String    @id @default(cuid())
  emitenteId              String
  dealId                  String?
  acordoId                String?
  parcelaNumero           Int?      // 0 = entrada; 1..N parcelas
  tipo                    String    // acordo | execucao
  descricao               String?
  vencimento              DateTime?
  valorPrevisto           Decimal?  @db.Decimal(14, 2)
  dataRecebimento         DateTime?
  valorBruto              Decimal?  @db.Decimal(14, 2) // efetivamente recebido (sem sucumbência)
  percHonorarios          Decimal?  @db.Decimal(5, 2)
  valorHonorarios         Decimal?  @db.Decimal(14, 2)
  valorSucumbencia        Decimal   @default(0) @db.Decimal(14, 2) // 100% do escritório, sem repasse
  valorRepasse            Decimal?  @db.Decimal(14, 2)
  comprovantePath         String?
  comprovanteNome         String?
  repasseStatus           String    @default("pendente") // pendente | realizado | nao_aplicavel
  repasseData             DateTime?
  repasseComprovantePath  String?
  repasseComprovanteNome  String?
  nfStatus                String    @default("a_emitir") // a_emitir | emitida | nao_aplicavel
  nfValor                 Decimal?  @db.Decimal(14, 2)
  nfNumero                String?
  nfData                  DateTime?
  nfAnexoPath             String?
  nfAnexoNome             String?
  notaFiscalId            String?   // NotaFiscal emitida pelo Avoce (sem FK: pode ser NF externa)
  obs                     String?
  criadoPorId             String?
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  deal     CrmDeal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  acordo   Acordo?         @relation(fields: [acordoId], references: [id], onDelete: SetNull)

  @@unique([acordoId, parcelaNumero])
  @@index([emitenteId, vencimento])
  @@index([emitenteId, dataRecebimento])
  @@index([dealId])
  @@index([repasseStatus])
  @@index([nfStatus])
}

// Trilha de auditoria das mutações do financeiro gerencial e dos acordos.
model FinAuditLog {
  id         String   @id @default(cuid())
  emitenteId String?
  entidade   String   // nome do modelo (ex.: Lancamento, FinEmprestimoMov, Acordo)
  entidadeId String
  acao       String   // criar | atualizar | excluir
  usuarioId  String?
  antes      Json?
  depois     Json?
  criadoEm   DateTime @default(now())

  @@index([emitenteId, criadoEm])
  @@index([entidade, entidadeId])
}
