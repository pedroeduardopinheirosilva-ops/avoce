// ─────────────────────────────────────────────
// Banking Module
// ─────────────────────────────────────────────

model BankAccount {
  id                String       @id @default(cuid())
  emitenteId        String
  provider          BankProvider
  name              String       @db.VarChar(100)
  bankCode          String       @db.VarChar(10)
  agency            String       @db.VarChar(10)
  agencyDigit       String?      @db.VarChar(2)
  account           String       @db.VarChar(20)
  accountDigit      String?      @db.VarChar(2)
  accountType       String       @db.VarChar(10)
  pixKey            String?      @db.VarChar(100)
  isDefault         Boolean      @default(false)
  isActive          Boolean      @default(true)
  currentBalance    Decimal      @default(0) @db.Decimal(15, 2)
  balanceDate       DateTime?
  externalAccountId String?      @db.VarChar(100)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  emitente          EmpresaEmitente  @relation(fields: [emitenteId], references: [id])
  credential        BankCredential?
  statements        BankStatement[]
  syncLogs          StatementSyncLog[]
  @@unique([emitenteId, provider, account])
  @@index([emitenteId])
  @@map("bank_accounts")
}

model BankCredential {
  id             String         @id @default(cuid())
  emitenteId     String
  bankAccountId  String         @unique
  credentialType CredentialType
  certData       String?        @db.Text
  certPassword   String?        @db.Text
  certPem        String?        @db.Text
  keyPem         String?        @db.Text
  clientId       String?        @db.Text
  clientSecret   String?        @db.Text
  expiresAt      DateTime?
  isActive       Boolean        @default(true)
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bankAccount    BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  @@index([emitenteId])
  @@map("bank_credentials")
}

model BankStatement {
  id                   String               @id @default(cuid())
  emitenteId           String
  bankAccountId        String
  externalId           String?              @db.VarChar(100)
  entryDate            DateTime
  valueDate            DateTime?
  amount               Decimal              @db.Decimal(15, 2)
  entryType            EntryType
  balance              Decimal?             @db.Decimal(15, 2)
  description          String               @db.VarChar(500)
  documentNumber       String?              @db.VarChar(100)
  counterpartyName     String?              @db.VarChar(200)
  counterpartyDocument String?              @db.VarChar(20)
  category             String?              @db.VarChar(100)
  source               StatementSource      @default(API_SYNC)
  rawData              Json?
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  reconciledAt         DateTime?
  reconciledBy         String?
  cobrancaId           String?              @unique
  createdByUserId      String?
  updatedByUserId      String?
  attachmentUrl        String?              @db.VarChar(500)
  attachmentName       String?              @db.VarChar(200)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  cobranca             Cobranca?            @relation(fields: [cobrancaId], references: [id])
  groupMatches         BankStatementMatch[]
  @@unique([bankAccountId, externalId])
  @@index([emitenteId, bankAccountId, entryDate])
  @@index([emitenteId, reconciliationStatus])
  @@map("bank_statements")
}

// Conciliação N:1 — um lançamento do extrato (ex.: CRÉD.LIQUIDAÇÃO COBRANÇA)
// liquidando VÁRIAS cobranças de uma vez. O vínculo 1:1 (cobrancaId acima)
// continua sendo usado para matches simples.
model BankStatementMatch {
  id          String        @id @default(cuid())
  statementId String
  cobrancaId  String        @unique
  createdAt   DateTime      @default(now())
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  cobranca    Cobranca      @relation(fields: [cobrancaId], references: [id])
  @@index([statementId])
  @@map("bank_statement_matches")
}

model StatementSyncLog {
  id             String      @id @default(cuid())
  emitenteId     String
  bankAccountId  String
  startDate      DateTime
  endDate        DateTime
  status         SyncStatus  @default(PENDING)
  recordsFetched Int         @default(0)
  recordsNew     Int         @default(0)
  errorMessage   String?     @db.Text
  durationMs     Int?
  triggeredBy    String      @db.VarChar(20)
  createdAt      DateTime    @default(now())
  finishedAt     DateTime?
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  @@index([emitenteId, bankAccountId, createdAt])
  @@map("statement_sync_logs")
}

model IaNotificacaoEvento {
  id        String   @id @default(cuid())
  projetoId String
  nome      String
  evento    String
  destino   String
  mensagem  String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model IaNotificacaoLog {
  id        String   @id @default(cuid())
  projetoId String
  dealId    String?
  evento    String
  destino   String
  mensagem  String   @db.Text
  nomeLead  String?
  enviadaEm DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model IaProjetoUsuario {
  id           String   @id @default(cuid())
  projetoId    String
  usuarioId    String
  funcao       String   @default("atendente")
  nomeWhatsapp String?
  criadoEm     DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  usuario Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([projetoId, usuarioId])
}

model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Marketing Autopilot — Automação de Marketing
// ─────────────────────────────────────────────

enum MktPlataforma {
  META
  GOOGLE
}

enum MktCampanhaStatus {
  ATIVA
  PAUSADA
  ARQUIVADA
  RASCUNHO
}

enum MktCriativoStatus {
  ATIVO
  PAUSADO
  ARQUIVADO
}

enum MktAutonomia {
  TOTAL
  NOTIFICAR
  SUGERIR
}

enum MktFormato {
  REEL
  CARROSSEL
  POST
  STORY
}

enum MktRoteiroStatus {
  GERADO
  GRAVADO
  EDITADO
  APROVADO
}

enum MktPublicacaoStatus {
  RASCUNHO
  AGUARDANDO_MIDIA
  PROCESSANDO_CONTAINER
  AGENDADO
  PUBLICADO
  FALHOU
}

model MktProjeto {
  id           String   @id @default(cuid())
  emitenteId   String
  nome         String
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  emitente    EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  configs     MktConfig[]
  campanhas   MktCampanha[]
  roteiros    MktRoteiro[]
  publicacoes MktPublicacao[]
  logs        MktLogAcao[]
}

// Credenciais e settings — segue padrão exato de IaProjetoConfig
model MktConfig {
  id             String   @id @default(cuid())
  projetoId      String
  chave          String
  valor          String?
  valorEncrypted Boolean  @default(false)
  tipo           String   @default("texto") // texto | senha | booleano | numero
  categoria      String   @default("geral") // meta | google | deepseek | imagem | video
  descricao      String?
  editavelPainel Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  projeto MktProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

// Campanhas sincronizadas do Meta Ads e Google Ads
model MktCampanha {
  id              String            @id @default(cuid())
  projetoId       String
  plataforma      MktPlataforma
  idExterno       String
  nome            String
  status          MktCampanhaStatus @default(ATIVA)
  orcamentoDiario Float?
  cpaMeta         Float?
  roasMeta        Float?
  autonomia       MktAutonomia      @default(NOTIFICAR)
  // Métricas atuais (atualizadas a cada hora)
  impressoes      Int               @default(0)
  cliques         Int               @default(0)
  gastoTotal      Float             @default(0)
  cpaAtual        Float?
  roasAtual       Float?
  ctrAtual        Float?
  // Controle de violação de KPI consecutiva
  kpiVioladoCount Int               @default(0)
  ultimaSincEm    DateTime?
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  projeto   MktProjeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  criativos MktCriativo[]

  @@unique([projetoId, idExterno, plataforma])
}

model MktCriativo {
  id           String            @id @default(cuid())
  campanhaId   String
  idExterno    String
  nome         String
  status       MktCriativoStatus @default(ATIVO)
  ctr          Float?
  cpc          Float?
  pausadoPorIa Boolean           @default(false)
  motivoPausa  String?
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  campanha MktCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, idExterno])
}

// Roteiros de vídeo gerados pelo DeepSeek
model MktRoteiro {
  id            String           @id @default(cuid())
  projetoId     String
  advogadoNome  String
  areaDireito   String
  tema          String
  formato       MktFormato
  tom           String
  titulo        String
  cenas         Json             // [{ordem, descricao, duracao, textoNarrado, dicaGravacao}]
  caption       String           @db.Text
  hashtags      String[]
  dicasGravacao String[]
  promptUsado   String           @db.Text
  status        MktRoteiroStatus @default(GERADO)
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  projeto     MktProjeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  publicacoes MktPublicacao[]
}

// Calendário editorial — posts agendados para o Instagram
model MktPublicacao {
  id           String              @id @default(cuid())
  projetoId    String
  roteiroId    String?
  titulo       String
  legenda      String              @db.Text
  hashtags     String[]
  urlMidia     String?
  containerId  String?             // Meta container ID — polling enquanto PROCESSANDO_CONTAINER
  agendadoPara DateTime?
  publicadoEm  DateTime?
  idPostIg     String?
  status       MktPublicacaoStatus @default(RASCUNHO)
  // Métricas coletadas após publicação
  alcance      Int?
  impressoes   Int?
  likes        Int?
  comentarios  Int?
  plays        Int?
  aprovadoEm   DateTime?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  projeto  MktProjeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  roteiro  MktRoteiro? @relation(fields: [roteiroId], references: [id])
}

model CrmCampanhaReengajamento {
  id             String    @id @default(cuid())
  empresaId      String?
  projetoId      String?
  pipelineId     String?
  nome           String
  stageIds       String[]
  diasSemContato Int       @default(7)
  mensagem       String    @db.Text
  ativa          Boolean   @default(true)
  ultimoDisparo  DateTime?
  totalEnviados  Int       @default(0)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  // Campanha IA personalizada
  tipo              String    @default("fixo")   // "fixo" | "ia_personalizada"
  promptInicial     String?   @db.Text           // prompt LLM para msg inicial personalizada
  promptHistorico   String?   @db.Text           // prompt LLM para resumo histórico pós-resposta
  sourcePipelineIds String[]  @default([])       // pipelines de origem dos leads
  destPipelineId    String?                      // pipeline destino após engajamento
  destStageMap      Json?                        // {stageChave: destStageChave, default: "..."}

  projeto IaProjeto? @relation(fields: [projetoId], references: [id])
}

// Log de toda ação automática — auditoria e reversão
model MktLogAcao {
  id           String   @id @default(cuid())
  projetoId    String
  tipo         String   // campanha_pausada | orcamento_ajustado | post_publicado | criativo_pausado | token_alerta
  entidadeId   String
  entidadeTipo String   // MktCampanha | MktCriativo | MktPublicacao
  valorAntes   Json?
  valorDepois  Json?
  motivoIa     String?  // reasoning do DeepSeek
  revertivel   Boolean  @default(false)
  revertido    Boolean  @default(false)
  revertidoEm  DateTime?
  ok           Boolean  @default(true)
  erroDetalhe  String?
  criadoEm     DateTime @default(now())

  projeto MktProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// VoIP — Ligações
// ─────────────────────────────────────────────

enum CrmLigacaoStatus {
  DISCANDO
  EM_ANDAMENTO
  ENCERRADA
  FALHOU
  SEM_RESPOSTA
  OCUPADO
}

model CrmLigacao {
  id               String           @id @default(cuid())
  dealId           String
  contatoId        String
  emitenteId       String
  usuarioId        String?

  numeroOrigem     String
  numeroDestino    String
  did              String?           // "61" | "11"
  duracao          Int?              // segundos
  status           CrmLigacaoStatus  @default(DISCANDO)

  asteriskUniqueId String?
  gravacaoMinio    String?           // chave no bucket avoce-calls
  transcricao      String?           @db.Text
  resumo           String?           @db.Text

  iniciadaEm       DateTime          @default(now())
  encerradaEm      DateTime?

  deal     CrmDeal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contato  CrmContato      @relation(fields: [contatoId], references: [id])
  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])

  @@index([dealId])
}

// ─────────────────────────────────────────────
// Reuniões — Videochamadas via Jitsi
// ─────────────────────────────────────────────

model SessaoReuniao {
  id              String    @id @default(cuid())
  dealId          String?
  contatoId       String?
  empresaId       String?
  emitenteId      String?
  criadoPor       String?
  titulo          String
  status          String    @default("agendada") // agendada | em_andamento | encerrada | cancelada
  jitsiRoomName   String    @unique
  tokenConvidado  String    @unique @default(cuid())
  agendadaPara    DateTime?
  iniciadaEm      DateTime?
  encerradaEm     DateTime?
  duracao         Int?
  transcricao     String?   @db.Text
  notas           String?   @db.Text
  resumoIa        String?   @db.Text  // relatório IA pós-reunião
  consentimentoEm DateTime? // consentimento LGPD do convidado p/ gravação+transcrição
  consentimentoIp String?
  criadaEm        DateTime  @default(now())
  atualizadaEm    DateTime  @updatedAt

  deal     CrmDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contato  CrmContato?      @relation(fields: [contatoId], references: [id])
  emitente EmpresaEmitente? @relation(fields: [emitenteId], references: [id])
  chunks   ReuniaoTranscricaoChunk[]
}

// Transcrição de reunião — 1 chunk por fala, rotulado por quem gravou
// (cada participante transcreve o próprio microfone; papel conhecido a priori)
model ReuniaoTranscricaoChunk {
  id             String   @id @default(cuid())
  sessaoId       String
  speakerRole    String   @default("indefinido") // operador | convidado | indefinido
  speakerNome    String?
  conteudo       String   @db.Text
  inicioSegundos Int?     // contador local da página de quem gravou (aproximado)
  origem         String   @default("whisper")    // webspeech | whisper
  criadaEm       DateTime @default(now())

  sessao SessaoReuniao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId, criadaEm])
}

// Agenda — Slots de disponibilidade para reuniões
// ─────────────────────────────────────────────

model AgendaSlot {
  id            String    @id @default(cuid())
  emitenteId    String
  usuarioId     String?
  projetoId     String?
  titulo        String?
  inicio        DateTime
  fim           DateTime
  disponivel    Boolean   @default(true)
  reservadoPara String?   // dealId quando reservado
  reuniaoId     String?   // SessaoReuniao.id quando criada
  criadaEm      DateTime  @default(now())

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id], onDelete: Cascade)
  usuario  Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emitenteId, inicio])
  @@index([projetoId, inicio])
  @@index([usuarioId, inicio])
}

// ─────────────────────────────────────────────
// SDR Gates — Desqualificação configurável
// ─────────────────────────────────────────────

model IaGateSdr {
  id             String   @id @default(cuid())
  projetoId      String
  nome           String
  tipo           String   // prescricao | empresa_bloqueada | vinculo_invalido | nao_carreteiro | tempo_minimo | campo_booleano
  campoGatilho   String?
  condicaoJson   Json?
  mensagemLead   String   @db.Text
  motivoChave    String   @default("gate_desqualificado")
  stageDestino   String   @default("lead_desqualificado")
  ativo          Boolean  @default(true)
  ordem          Int      @default(0)
  criadoEm       DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId, ativo])
}

model IaEmpresaBloqueada {
  id         String   @id @default(cuid())
  projetoId  String
  nome       String
  nomeNorm   String
  motivo     String   @default("prescricao_coletiva")
  descricao  String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId, ativo])
}

// ─────────────────────────────────────────────
// Assinaturas — assinatura eletrônica via PAKT
// ─────────────────────────────────────────────

model Assinatura {
  id                        String    @id @default(cuid())
  paktDocumentId            String?   @unique
  emitenteId                String    // escritório remetente (RAP ou PSA) citado no texto
  nome                      String
  status                    String    @default("DRAFT")
  mensagem                  String?   @db.Text
  expiresAt                 DateTime?
  paktResponse              Json?

  arquivoNome               String?
  arquivoPath               String?
  arquivoTamanho            Int?
  arquivoAssinadoPath       String?
  arquivoAssinadoEm         DateTime?

  criadoPorId               String?
  criadoPorNome             String?

  signatarios               Json      @default("[]")

  tomadorId                 String?
  dealId                    String?

  emailEnviado              Boolean   @default(false)
  emailEnviadoEm            DateTime?
  whatsappEnviado           Boolean   @default(false)
  whatsappEnviadoEm         DateTime?
  whatsappAssinadoEnviado   Boolean   @default(false)
  whatsappAssinadoEnviadoEm DateTime?

  webhookEventos            Json      @default("[]")

  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  tomador  Tomador?        @relation(fields: [tomadorId], references: [id])

  @@index([emitenteId, status])
  @@index([criadoEm])
}
