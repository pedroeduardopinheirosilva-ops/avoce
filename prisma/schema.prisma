generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BankProvider {
  SICOOB
  BRADESCO
  INTER
  BTG
}

enum CredentialType {
  MTLS_CERT
  MTLS_KEYPAIR
  OAUTH2
}

enum StatementSource {
  API_SYNC
  OFX_IMPORT
  MANUAL
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  MANUAL
  IGNORED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

model Usuario {
  id       String   @id @default(cuid())
  email    String   @unique
  senha    String
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  projetoUsuarios IaProjetoUsuario[]
}

model EmpresaEmitente {
  id                     String              @id @default(cuid())
  nome                   String
  cnpj                   String              @unique
  inscricaoMunicipal     String
  regime                 String              @default("2")
  aliquotaIss            Float               @default(0.05)
  itemListaServico       String              @default("1.01")
  codTributacao          String              @default("0101")
  certNome               String?
  certValidade           DateTime?
  ativo                  Boolean             @default(true)
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt
  bairro                 String?
  cep                    String?
  cidade                 String?
  codigoMunicipio        String?
  complemento            String?
  email                  String?
  endereco               String?
  inscricaoEstadual      String?
  nomeFantasia           String?
  numero                 String?
  telefone               String?
  uf                     String?
  smtpFrom               String?
  smtpHost               String?
  smtpPass               String?
  smtpPort               Int?
  smtpSecure             Boolean             @default(false)
  smtpUser               String?
  certPass               String?
  logoPath               String?
  pixClientId            String?
  pixChave               String?
  boletoClientId         String?
  boletoNumeroCliente    String?
  boletoContaCorrente    String?
  boletoModalidade       String?             @default("1")
  boletoContratoCobranca String?
  boletoMultaPercent     Float?              @default(2)
  boletoJurosDiaPercent  Float?              @default(0.033)
  codigoNbs              String?
  codigoServicoNacional  String?
  regimeTributacao       String?
  timbradoPath           String?
  faturamentoAutoAtivo   Boolean             @default(false)
  diaEmissaoNfse         Int?

  cobrancas          Cobranca[]
  contratos          Contrato[]
  notas              NotaFiscal[]
  propostas          Proposta[]
  templateDocumentos TemplateDocumento[]
  bankAccounts       BankAccount[]
}

model Tomador {
  id                String          @id @default(cuid())
  nome              String
  cpfCnpj           String          @unique
  email             String?
  emailFinanceiro   String?
  emailGeral        String?
  emailDiretoria    String?
  telefone          String?
  endereco          String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  codigoMunicipio   String?
  uf                String?
  cep               String?
  inscMunicipal     String?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt
  inscricaoEstadual String?
  nomeFantasia      String?
  dataNascimento    DateTime?
  nacionalidade     String?
  estadoCivil       String?
  profissao         String?
  rg                String?
  rgOrgaoEmissor    String?
  naturalidade      String?
  capitalSocial     Int?
  dataConstituicao  DateTime?
  tipoSocietario    String?
  objetoSocial      String?
  regimeCasamento   String?

  administradores Administrador[]
  contratos       Contrato[]
  propostas       Proposta[]
}

model Administrador {
  id              String    @id @default(cuid())
  tomadorId       String
  nome            String
  cpf             String?
  cargo           String?   @default("Administrador")
  nacionalidade   String?
  estadoCivil     String?
  profissao       String?
  rg              String?
  rgOrgaoEmissor  String?
  dataNascimento  DateTime?
  naturalidade    String?
  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  uf              String?
  cep             String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  regimeCasamento String?

  tomador Tomador @relation(fields: [tomadorId], references: [id])
}

model Contrato {
  id                   String          @id @default(cuid())
  emitenteId           String
  tomadorId            String
  descricaoServico     String
  valor                Int
  diaVencimento        Int
  issRetido            Boolean         @default(false)
  ativo                Boolean         @default(true)
  observacoes          String?
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @updatedAt
  codigoNbs            String?
  itemListaServico     String?
  retirCofins          Boolean         @default(false)
  retirCsll            Boolean         @default(false)
  retirIr              Boolean         @default(false)
  retirPis             Boolean         @default(false)
  nomeServico          String?
  gerarCobrancaAuto    Boolean         @default(true)
  metodoCobr           String          @default("PIX_BOLETO")
  emitirNfseAuto       Boolean         @default(true)
  tipoContrato         String          @default("RECORRENTE")
  totalParcelas        Int?
  contratoAssinadoPath String?
  contratoAssinadoNome String?
  contratoAssinadoEm   DateTime?

  cobrancas Cobranca[]
  emitente  EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  tomador   Tomador         @relation(fields: [tomadorId], references: [id])
  notas     NotaFiscal[]
  proposta  Proposta?
}

model Proposta {
  id                        String            @id @default(cuid())
  emitenteId                String
  tomadorId                 String
  titulo                    String
  textoHtml                 String
  status                    String            @default("RASCUNHO")
  valorEstimado             Int?
  validadeAte               DateTime?
  tokenAceite               String            @unique @default(cuid())
  paktSignUrl               String?
  aceitoEm                  DateTime?
  aceitoIp                  String?
  contratoId                String?           @unique
  criadoEm                  DateTime          @default(now())
  atualizadoEm              DateTime          @updatedAt
  paktDocumentId            String?
  contratoDiaVencimento     Int?
  contratoMetodoCobr        String?           @default("PIX_BOLETO")
  contratoTipoContrato      String?           @default("RECORRENTE")
  contratoTotalParcelas     Int?
  contratoEmitirNfseAuto    Boolean?          @default(true)
  contratoGerarCobrancaAuto Boolean?          @default(true)
  contratoIssRetido         Boolean?          @default(false)
  contratoDescricao         String?
  paktSignedPdfPath         String?
  templatesGerar            String?
  honorariosExitoPerc       Int?

  documentosGerados DocumentoGerado[]
  contrato          Contrato?         @relation(fields: [contratoId], references: [id])
  emitente          EmpresaEmitente   @relation(fields: [emitenteId], references: [id])
  tomador           Tomador           @relation(fields: [tomadorId], references: [id])
}

model TemplateDocumento {
  id           String            @id @default(cuid())
  emitenteId   String
  tipo         String
  titulo       String
  textoHtml    String
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  cabecalhoPath String?

  documentosGerados DocumentoGerado[]
  emitente          EmpresaEmitente   @relation(fields: [emitenteId], references: [id])
}

model DocumentoGerado {
  id         String            @id @default(cuid())
  propostaId String
  templateId String
  tipo       String
  titulo     String
  pdfPath    String?
  criadoEm   DateTime          @default(now())
  docxPath   String?

  proposta Proposta          @relation(fields: [propostaId], references: [id])
  template TemplateDocumento @relation(fields: [templateId], references: [id])
}

model Cobranca {
  id                   String          @id @default(cuid())
  contratoId           String
  emitenteId           String
  competencia          String
  valor                Int
  vencimento           String
  pixTxid              String?
  pixBrcode            String?
  pixQrcode            String?
  pixStatus            String          @default("PENDENTE")
  pixExpiresAt         DateTime?
  boletoNossoNumero    Int?
  boletoLinhaDigitavel String?
  boletoCodigoBarras   String?
  boletoUrlPdf         String?
  boletoStatus         String          @default("AGUARDANDO")
  boletoPagoEm         String?
  boletoValorPago      Int?
  criadoEm             DateTime        @default(now())
  atualizadoEm         DateTime        @updatedAt
  pixEndToEndId        String?
  pixPagadorDoc        String?
  pixPagadorNome       String?
  pixPagoEm            DateTime?

  contrato      Contrato        @relation(fields: [contratoId], references: [id])
  emitente      EmpresaEmitente @relation(fields: [emitenteId], references: [id])
  bankStatement BankStatement?

  reconciledAt    DateTime?
  reconciledBy    String?
}

model NotaFiscal {
  id           String          @id @default(cuid())
  contratoId   String
  emitenteId   String
  competencia  String
  valor        Int
  numero       String?
  codigoVerif  String?
  status       String          @default("PENDENTE")
  xmlRetorno   String?
  linkNfse     String?
  erroMsg      String?
  emitidoEm    DateTime?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  contrato Contrato        @relation(fields: [contratoId], references: [id])
  emitente EmpresaEmitente @relation(fields: [emitenteId], references: [id])
}

// ─────────────────────────────────────────────
// CRM — Funil Kanban (Avoce)
// ─────────────────────────────────────────────

model CrmPipeline {
  id        String     @id @default(cuid())
  nome      String
  descricao String?
  cor       String     @default("#6366f1")
  ordem     Int        @default(0)
  tipo      String     @default("comercial") // comercial | processual
  ativo     Boolean    @default(true)
  criadoEm  DateTime   @default(now())

  stages CrmStage[]
  deals  CrmDeal[]
}

model CrmStage {
  id               String   @id @default(cuid())
  pipelineId       String
  chave            String
  nome             String
  ordem            Int
  cor              String   @default("#6366f1")
  ehEntrada        Boolean  @default(false)
  ehGanho          Boolean  @default(false)
  ehEncerramento   Boolean  @default(false)
  requerAcaoHumana Boolean  @default(false)
  ativo            Boolean  @default(true)

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([pipelineId, chave])
}

model CrmDeal {
  id               String    @id @default(cuid())
  titulo           String
  pipelineId       String
  stageId          String
  contatoId        String?
  responsavelId    String?
  projetoId        String?
  valor            Decimal?  @db.Decimal(12, 2)
  status           String    @default("aberto") // aberto | ganho | perdido
  urgencia         Boolean   @default(false)
  fonteLead        String?
  descricao        String?
  camposCustom     Json?
  numeroCnj        String?
  proximoPrazo     DateTime?
  qualificacao     Json?
  ultimoContatoEm  DateTime?
  // Avaliação jurídica
  parecer          String?   // Texto do parecer da Dra. Daniela
  valorEstimado    Decimal?  @db.Decimal(12, 2)  // Estimativa IA do valor da causa
  valorCausaAjuizada Decimal? @db.Decimal(12, 2) // Valor da causa no processo ajuizado
  valorCondenacao  Decimal?  @db.Decimal(12, 2)  // Valor da condenação
  valorAcordo      Decimal?  @db.Decimal(12, 2)  // Valor do acordo homologado
  // IA fields
  iaAtiva          Boolean   @default(true)
  iaStageChave     String?
  iaPersonaChave   String?
  iaPausadaPor     String?
  iaPausadaEm      DateTime?
  closerTentativas Int       @default(0)
  proximoContatoEm DateTime?
  docsConfirmados  Boolean   @default(false)
  iaFlowStepChave  String?   // current step in flow controller (advogado phase)
  iaFlowStepData   Json?     // data collected by flow controller (advogado phase)
  iaFlags          Json?     // internal AI operational flags (keys prefixed with _)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  pipeline  CrmPipeline         @relation(fields: [pipelineId], references: [id])
  stage     CrmStage            @relation(fields: [stageId], references: [id])
  contato   CrmContato?         @relation(fields: [contatoId], references: [id])
  projeto   IaProjeto?          @relation(fields: [projetoId], references: [id])
  stageLog  CrmDealStageLog[]
  notas     CrmNota[]
  mensagens CrmMensagemWhatsapp[]
  vinculos  CrmVinculoEmprego[]
}

model CrmDealStageLog {
  id              String   @id @default(cuid())
  dealId          String
  stageAnteriorId String?
  stageNovoId     String
  usuarioId       String?
  motivo          String?
  criadoEm        DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model CrmNota {
  id        String   @id @default(cuid())
  dealId    String
  usuarioId String?
  conteudo  String
  criadoEm  DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model CrmContato {
  id           String   @id @default(cuid())
  nome         String
  whatsapp     String?
  cpf          String?
  email        String?
  cidade       String?
  profissao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  deals     CrmDeal[]
  mensagens CrmMensagemWhatsapp[]
}

// ─────────────────────────────────────────────
// IA — Agente WhatsApp (Avoce)
// ─────────────────────────────────────────────

model IaProjeto {
  id                String   @id @default(cuid())
  nome              String
  descricao         String?
  ativo             Boolean  @default(true)
  whatsappInstancia String?
  criadoEm          DateTime @default(now())

  configs    IaProjetoConfig[]
  personas   IaPersona[]
  fases      IaFaseFunil[]
  perguntas  IaPerguntaQualificacao[]
  templates  IaMensagemTemplate[]
  regras     IaRegraTransicao[]
  logs       IaInteracaoLog[]
  deals           CrmDeal[]
  provedores      IaLlmProvedor[]
  notificacoes    IaNotificacaoEvento[]
  projetoUsuarios IaProjetoUsuario[]
  vinculoFlow     IaVinculoFlowPasso[]
  flowSteps       IaFlowStep[]
}

model IaVinculoFlowPasso {
  id           String   @id @default(cuid())
  projetoId    String
  chave        String   // "empresa" | "funcao" | "vinculo" | "saida" | "horas_extras" | "pagamento_fora" | "injustica" | "frota" | "mais_empregos" | custom
  pergunta     String   @db.Text
  campoColetar String?  // field key in VinculoEmprego; null for tipoEspecial steps
  ordemPadrao  Int      @default(0)
  ativo        Boolean  @default(true)
  skipSe       Json?    // { "campo": "vinculo", "contem_qualquer": ["clt", "carteira"] }
  tipoEspecial String?  // "mais_empregos" | null
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

// ─────────────────────────────────────────────
// Flow Controller — steps & gates por persona
// ─────────────────────────────────────────────

model IaFlowStep {
  id           String       @id @default(cuid())
  projetoId    String
  personaChave String       // "assistente" | "advogado"
  fase         String       // "pre_vinculos" | "pos_vinculos" | "advogado"
  chave        String
  ordem        Int
  label        String
  pergunta     String       @db.Text
  stepType     String       @default("question") // "question" | "gate" | "document" | "end" | "saudacao" | "llm_generated"
  subFase      String?      // "advogado_valor" | "advogado_dados" | "advogado_documentos"
  campoColetar String?      // key in qualificacao JSON or iaFlowStepData JSON
  skipSe       Json?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  gates        IaFlowGate[]
  projeto      IaProjeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, personaChave, chave])
}

model IaFlowGate {
  id          String     @id @default(cuid())
  stepId      String
  condicao    String     @db.Text
  actionType  String     // "continue" | "goto_step" | "end" | "discard" | "repeat" | "notify" | "wait"
  actionValue String?    // target step chave, end message, etc.
  label       String?
  cor         String?
  ordem       Int        @default(0)
  criadoEm    DateTime   @default(now())
  step        IaFlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model IaLlmProvedor {
  id        String  @id @default(cuid())
  projetoId String
  ordem     Int
  provider  String  // anthropic | openai | groq | gemini
  modelo    String
  apiKey    String
  ativo     Boolean @default(true)

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, ordem])
}

model IaProjetoConfig {
  id             String   @id @default(cuid())
  projetoId      String
  chave          String   // evolution_api_url | evolution_api_key | anthropic_api_key | etc.
  valor          String?
  valorEncrypted Boolean  @default(false)
  descricao      String?
  tipo           String   @default("texto") // texto | senha | booleano | numero
  categoria      String?  // llm | whatsapp | audio | comportamento | pakt
  editavelPainel Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

model IaPersona {
  id             String  @id @default(cuid())
  projetoId      String
  chave          String  // assistente | advogado | closer
  nomeExibicao   String
  descricaoPapel String?
  systemPrompt   String
  tom              String  @default("profissional")
  ordem            Int     @default(0)
  ativo            Boolean @default(true)
  ttsVoiceId       String?
  llmProviderChave String? // se definido, usa o provedor com este nome (ex: "gemini", "anthropic") em vez do padrão do projeto

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

model IaFaseFunil {
  id               String  @id @default(cuid())
  projetoId        String
  pipelineId       String?
  chave            String
  nomeExibicao     String
  descricao        String?
  ordem            Int
  cor              String  @default("#6366f1")
  personaChave     String?
  pipelineTipo     String  @default("comercial") // comercial | processual
  ehEntrada        Boolean @default(false)
  ehGanho          Boolean @default(false)
  ehEncerramento   Boolean @default(false)
  requerAcaoHumana Boolean @default(false)
  ativo            Boolean @default(true)

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

model IaPerguntaQualificacao {
  id               String  @id @default(cuid())
  projetoId        String
  chave            String
  perguntaContexto String
  exemploAbordagem String?
  tipoDado         String  @default("texto") // texto | booleano | numero | data
  opcoes           Json?
  obrigatorio      Boolean @default(true)
  ordem            Int
  stageColeta      String?
  ativo            Boolean @default(true)

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model IaMensagemTemplate {
  id           String  @id @default(cuid())
  projetoId    String
  chave        String
  descricao    String?
  template     String
  personaChave String?
  ativo        Boolean @default(true)

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, chave])
}

model IaRegraTransicao {
  id                    String  @id @default(cuid())
  projetoId             String
  stageOrigemChave      String?
  stageDestinoChave     String
  condicao              String
  parametros            Json?
  acaoAdicional         String?
  ordem                 Int     @default(0)
  requerPrescricaoAtiva Boolean @default(false)

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model IaInteracaoLog {
  id           String   @id @default(cuid())
  dealId       String?
  projetoId    String?
  personaChave String?
  stageChave   String?
  llmUsado     String?
  tokensEntrada Int?
  tokensSaida   Int?
  latenciaMs    Int?
  erro         String?
  criadoEm     DateTime @default(now())

  projeto IaProjeto? @relation(fields: [projetoId], references: [id])
}

model CrmMensagemWhatsapp {
  id                 String   @id @default(cuid())
  dealId             String?
  contatoId          String?
  direcao            String   // in | out
  remetente          String?
  personaChave       String?
  tipo               String   @default("text") // text | image | audio | document
  conteudo           String?
  midiaUrl           String?
  transcricao        String?
  evolutionMessageId String?
  lida               Boolean  @default(false)
  enviadaEm          DateTime @default(now())

  deal    CrmDeal?    @relation(fields: [dealId], references: [id])
  contato CrmContato? @relation(fields: [contatoId], references: [id])
}

model CrmVinculoEmprego {
  id               String    @id @default(cuid())
  dealId           String
  ordem            Int       @default(0)
  funcao           String?
  vinculo          String?   // CLT | autonomo | avulso | cooperado
  empresa          String?
  tempoServico     String?
  saida            String?
  frota            String?
  horasExtras      Boolean?
  pagamentoPorFora String?
  injusticas       String?
  dentroPresricao  Boolean?
  prazoPresricao   DateTime?
  acaoRecomendada  String?
  criadoEm         DateTime  @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Banking Module
// ─────────────────────────────────────────────

model BankAccount {
  id                String       @id @default(cuid())
  emitenteId        String
  provider          BankProvider
  name              String       @db.VarChar(100)
  bankCode          String       @db.VarChar(10)
  agency            String       @db.VarChar(10)
  agencyDigit       String?      @db.VarChar(2)
  account           String       @db.VarChar(20)
  accountDigit      String?      @db.VarChar(2)
  accountType       String       @db.VarChar(10)
  pixKey            String?      @db.VarChar(100)
  isDefault         Boolean      @default(false)
  isActive          Boolean      @default(true)
  currentBalance    Decimal      @default(0) @db.Decimal(15, 2)
  balanceDate       DateTime?
  externalAccountId String?      @db.VarChar(100)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  emitente          EmpresaEmitente  @relation(fields: [emitenteId], references: [id])
  credential        BankCredential?
  statements        BankStatement[]
  syncLogs          StatementSyncLog[]
  @@unique([emitenteId, provider, account])
  @@index([emitenteId])
  @@map("bank_accounts")
}

model BankCredential {
  id             String         @id @default(cuid())
  emitenteId     String
  bankAccountId  String         @unique
  credentialType CredentialType
  certData       String?        @db.Text
  certPassword   String?        @db.Text
  certPem        String?        @db.Text
  keyPem         String?        @db.Text
  clientId       String?        @db.Text
  clientSecret   String?        @db.Text
  expiresAt      DateTime?
  isActive       Boolean        @default(true)
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bankAccount    BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  @@index([emitenteId])
  @@map("bank_credentials")
}

model BankStatement {
  id                   String               @id @default(cuid())
  emitenteId           String
  bankAccountId        String
  externalId           String?              @db.VarChar(100)
  entryDate            DateTime
  valueDate            DateTime?
  amount               Decimal              @db.Decimal(15, 2)
  entryType            EntryType
  balance              Decimal?             @db.Decimal(15, 2)
  description          String               @db.VarChar(500)
  documentNumber       String?              @db.VarChar(100)
  counterpartyName     String?              @db.VarChar(200)
  counterpartyDocument String?              @db.VarChar(20)
  category             String?              @db.VarChar(100)
  source               StatementSource      @default(API_SYNC)
  rawData              Json?
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  reconciledAt         DateTime?
  reconciledBy         String?
  cobrancaId           String?              @unique
  createdByUserId      String?
  updatedByUserId      String?
  attachmentUrl        String?              @db.VarChar(500)
  attachmentName       String?              @db.VarChar(200)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  cobranca             Cobranca?            @relation(fields: [cobrancaId], references: [id])
  @@unique([bankAccountId, externalId])
  @@index([emitenteId, bankAccountId, entryDate])
  @@index([emitenteId, reconciliationStatus])
  @@map("bank_statements")
}

model StatementSyncLog {
  id             String      @id @default(cuid())
  emitenteId     String
  bankAccountId  String
  startDate      DateTime
  endDate        DateTime
  status         SyncStatus  @default(PENDING)
  recordsFetched Int         @default(0)
  recordsNew     Int         @default(0)
  errorMessage   String?     @db.Text
  durationMs     Int?
  triggeredBy    String      @db.VarChar(20)
  createdAt      DateTime    @default(now())
  finishedAt     DateTime?
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  @@index([emitenteId, bankAccountId, createdAt])
  @@map("statement_sync_logs")
}

model IaNotificacaoEvento {
  id        String   @id @default(cuid())
  projetoId String
  nome      String
  evento    String
  destino   String
  mensagem  String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model IaProjetoUsuario {
  id           String   @id @default(cuid())
  projetoId    String
  usuarioId    String
  funcao       String   @default("atendente")
  nomeWhatsapp String?
  criadoEm     DateTime @default(now())

  projeto IaProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  usuario Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([projetoId, usuarioId])
}

model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}
